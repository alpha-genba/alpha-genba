# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by Git, so your real passwords never reach GitHub.

# Password for the website's admin panel (/admin).
ADMIN_PASSWORD=choose-a-long-password

# Address the API listens on.
ADDR=:8080

# Leave empty in development: the backend then starts its own PostgreSQL automatically.
# In production, set it to your PostgreSQL connection string.
DATABASE_URL=

# Required in production: a long random string used to sign admin login cookies.
SESSION_SECRET=

# Set to "production" on the real server.
APP_ENV=
